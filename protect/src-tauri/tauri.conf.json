{
  "productName": "PDF Stream Printer",
  "version": "1.0.1",
  "identifier": "com.pdf-stream-printer.app",
  "build": {
    "frontendDist": "../src",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "PDF 流式打印器",
        "width": 880,
        "height": 640,
        "resizable": true,
        "minWidth": 720,
        "minHeight": 520,
        "center": true,
        "decorations": true
      }
    ],
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: https://asset.localhost; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "resources": ["pdfium.dll"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {}
    }
  }
}
